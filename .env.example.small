# ============================================================
# Homelab Llama - Template de variáveis de ambiente
# ============================================================
# PERFIL PEQUENO: 16 GB de RAM, GPU de 8 GB de VRAM.
#
# Copie para .env e ajuste. NUNCA versione o .env com valores reais.
#
# Diferencas para o perfil padrao (.env.example, 16 GB de VRAM):
#   - modelo de chat precisa ter no maximo ~4,5 GB (8B em Q4_K_M ou menor)
#   - contexto do chat 8192 em vez de 16384
#   - WhisperX no modelo medium, que usa ~2,6 GB de VRAM em vez de 4,2 GB
#   - limites de RAM apertados: os 8 servicos somam ~6 GB
#
# Rode scripts/check-hardware.py depois de baixar o modelo: ele diz se a
# maquina aguenta este perfil.
#
# Secrets que precisam de valor aleatório:
#   WEBUI_SECRET_KEY, ANYTHINGLLM_SIG_KEY, ANYTHINGLLM_SIG_SALT,
#   SEARXNG_SECRET, FRESHRSS_PASSWORD, FRESHRSS_API_PASSWORD
#
# Gere cada um com: openssl rand -hex 32
# ============================================================

# ============================================================
# Projeto e rede
# ============================================================
COMPOSE_PROJECT_NAME=homelab-llama
TZ=America/Sao_Paulo

# Interface de escuta no host (127.0.0.1 = somente local)
BIND_ADDRESS=127.0.0.1
PUBLIC_HOST=localhost

# Onde ficam os modelos GGUF e o cache
# Preencha: diretorio onde ficam os modelos GGUF
MODELS_DIR=./models

# ============================================================
# Imagens
# ============================================================
# Tags fixas. Para atualizar, troque a tag e rode: docker compose pull
LLAMA_GPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_CPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
ANYTHINGLLM_IMAGE=mintplexlabs/anythingllm:latest
VANE_IMAGE=itzcrazykns1337/vane:slim-latest
SEARXNG_IMAGE=searxng/searxng:latest
FRESHRSS_IMAGE=freshrss/freshrss:latest
WHISPERX_IMAGE=learnedmachine/whisperx-asr-service:0.4.3-blackwell

# ============================================================
# Portas no host
# ============================================================
OPENWEBUI_PORT=3000
ANYTHINGLLM_PORT=3001
VANE_PORT=3002
SEARXNG_PORT=8084
LLAMA_GPU_PORT=8085
LLAMA_EMBED_PORT=8086
FRESHRSS_PORT=3003
WHISPERX_PORT=9000

# ============================================================
# Endpoints internos (rede Docker)
# ============================================================
LLAMA_GPU_API_URL=http://llama-gpu:8080/v1
LLAMA_EMBED_API_URL=http://llama-embed:8080/v1
SEARXNG_INTERNAL_URL=http://searxng:8080
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
OPENAI_COMPAT_API_KEY=local-no-key-required

# ============================================================
# NVIDIA GPU
# ============================================================
NVIDIA_GPU_DEVICE_ID=0
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ============================================================
# llama.cpp - modelo de chat
# ============================================================
# Modelo carregado (deve ser o nome do arquivo em $MODELS_DIR/chat)
# Preencha: nome do modelo de chat (arquivo em $MODELS_DIR/chat)
# Preencha: nome do modelo de chat (arquivo em $MODELS_DIR/chat).
# Neste perfil o GGUF precisa ter no maximo ~4,5 GB. Exemplos de tamanho:
#   8B Q4_K_M ~4,9 GB | 8B Q3_K_M ~3,9 GB | 7B Q4_K_M ~4,4 GB | 9B Q4_K_M ~5,5 GB (nao cabe)
CHAT_MODEL=llama-3.1-8b-instruct-Q4_K_M

LLAMA_MODELS_MAX=1
LLAMA_MODELS_AUTOLOAD=true

# Memória e processamento
# Contexto do modelo de chat. Medido na RTX 5070 Ti 16GB com gemma-4-12b Q6_K:
# 16384 = 10,3 GB de VRAM | 32768 = 10,5 GB | 65536 = 12,2 GB.
# O WhisperX divide a GPU com o chat: contexto menor deixa VRAM para transcrever.
LLAMA_CTX_SIZE=8192
LLAMA_PARALLEL=1
LLAMA_GPU_LAYERS=80
LLAMA_CPU_MOE_LAYERS=24
LLAMA_THREADS=10
LLAMA_HTTP_THREADS=8

# Libera a VRAM depois de X segundos sem requisicoes (nao existe env var no
# llama.cpp, o Compose passa na linha de comando). 0 desliga.
LLAMA_SLEEP_IDLE_SECONDS=180

# CUDA
LLAMA_FLASH_ATTN=on
LLAMA_BATCH_SIZE=1024
# Ubatch menor = menos VRAM no buffer de computacao
LLAMA_UBATCH_SIZE=512
LLAMA_CONT_BATCHING=true
# --fit fica desligado de proposito: com o contexto e as camadas de GPU fixos
# no Compose, o ajuste aborta a inicializacao do servidor.
LLAMA_FIT=off
LLAMA_FIT_TARGET=1024
LLAMA_FIT_CTX=4096
# O projetor multimodal (mmproj) so e carregado com --mmproj explicito
LLAMA_MMPROJ_OFFLOAD=on
LLAMA_IMAGE_MAX_TOKENS=1024

# Cache
LLAMA_CACHE_PROMPT=true
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_CACHE_TYPE_V=q8_0
LLAMA_CACHE_RAM=8192
LLAMA_CONTEXT_SHIFT=false
LLAMA_JINJA=true
LLAMA_WEBUI=true
LLAMA_METRICS=true

# Limites de RAM por servico (teto, nao reserva)
LLAMA_GPU_MEM_LIMIT=6g
LLAMA_EMBED_MEM_LIMIT=2g
OPENWEBUI_MEM_LIMIT=3g
ANYTHINGLLM_MEM_LIMIT=3g

# Compressão de contexto (Open WebUI) - acompanhar o LLAMA_CTX_SIZE
ENABLE_CONTEXT_COMPACTION=true
CONTEXT_COMPACTION_TOKEN_THRESHOLD=6000
CONTEXT_COMPACTION_TOKEN_CAP=7000
CONTEXT_COMPACTION_RETENTION_PERCENTAGE=40

# Preencha (opcional): token do Hugging Face.
# Necessario no WhisperX para a diarizacao de falantes (pyannote community-1).
HF_TOKEN=

# ============================================================
# llama.cpp - embeddings
# ============================================================
EMBEDDING_HF_REPO=ggml-org/bge-m3-Q8_0-GGUF:Q8_0
EMBEDDING_MODEL=bge-m3
EMBEDDING_POOLING=cls
EMBEDDING_CTX_SIZE=8192
EMBEDDING_PARALLEL=2
EMBEDDING_THREADS=-1
EMBEDDING_BATCH_SIZE=1024
EMBEDDING_UBATCH_SIZE=1024
EMBEDDING_METRICS=true

# ============================================================
# Open WebUI
# ============================================================
# Preencha: chave de sessao do Open WebUI (openssl rand -hex 32)
WEBUI_SECRET_KEY=
OPENWEBUI_DEFAULT_LOCALE=pt-BR
OPENWEBUI_ENABLE_SIGNUP=true
OPENWEBUI_PERSISTENT_CONFIG=true
OPENWEBUI_WORKERS=1
OPENWEBUI_VECTOR_DB=chroma
OPENWEBUI_RAG_ENGINE=openai
OPENWEBUI_RAG_BATCH_SIZE=8
OPENWEBUI_RAG_TOP_K=5
OPENWEBUI_ENABLE_HYBRID_SEARCH=false
OPENWEBUI_ENABLE_WEB_SEARCH=true
OPENWEBUI_WEB_SEARCH_ENGINE=searxng
OPENWEBUI_WEB_SEARCH_RESULTS=5
OPENWEBUI_WEB_SEARCH_CONCURRENCY=1
OPENWEBUI_WEB_LOADER_CONCURRENCY=2
OPENWEBUI_USER_AGENT=MyOpenWebUIInstance/1.0 (Docker; Linux; production)
OPENWEBUI_WHISPER_MODEL=medium
OPENWEBUI_WHISPER_LANGUAGE=pt
OPENWEBUI_WHISPER_MULTILINGUAL=true
# O container do Open WebUI nao tem GPU: o motor local de STT precisa de int8
OPENWEBUI_WHISPER_COMPUTE_TYPE=int8
# STT (transcricao) via API compativel com OpenAI -> servico WhisperX
OPENWEBUI_AUDIO_STT_ENGINE=openai
OPENWEBUI_AUDIO_STT_OPENAI_API_BASE_URL=http://whisperx:9000/v1
OPENWEBUI_AUDIO_STT_OPENAI_API_KEY=local-no-key-required
# Origens permitidas no navegador do Open WebUI
CORS_ALLOW_ORIGINS=http://localhost

# ============================================================
# AnythingLLM
# ============================================================
# Preencha: chave de assinatura do AnythingLLM (openssl rand -hex 32)
ANYTHINGLLM_SIG_KEY=
# Preencha: salt de assinatura do AnythingLLM (openssl rand -hex 32)
ANYTHINGLLM_SIG_SALT=
ANYTHINGLLM_LLM_PROVIDER=generic-openai
# Teto de tokens por RESPOSTA do modelo (padrao da imagem: 1024, corta demais)
ANYTHINGLLM_GENERIC_MAX_TOKENS=2048
ANYTHINGLLM_EMBEDDING_ENGINE=generic-openai
ANYTHINGLLM_EMBEDDING_CHUNK_LENGTH=8192
ANYTHINGLLM_EMBEDDING_CONCURRENCY=4
ANYTHINGLLM_EMBEDDING_DELAY_MS=0
ANYTHINGLLM_VECTOR_DB=lancedb
ANYTHINGLLM_OCR_LANGUAGES=por,eng
ANYTHINGLLM_DISABLE_TELEMETRY=true
ANYTHINGLLM_CHROMIUM_ARGS=--no-sandbox,--disable-setuid-sandbox

# ============================================================
# Vane
# ============================================================
VANE_DISABLE_TELEMETRY=1

# ============================================================
# SearXNG
# ============================================================
# Preencha: secret do SearXNG (openssl rand -hex 32)
SEARXNG_SECRET=
SEARXNG_LIMITER=false
SEARXNG_IMAGE_PROXY=true
# O idioma de busca fica em config/searxng/settings.yml (search.default_lang)

# ============================================================
# FreshRSS
# ============================================================
# Preencha: nome do usuario do FreshRSS
FRESHRSS_USERNAME=suporte
# Preencha: senha do usuario do FreshRSS
FRESHRSS_PASSWORD=
# Preencha: senha da API do FreshRSS
FRESHRSS_API_PASSWORD=
FRESHRSS_BASE_URL=http://localhost:3003
# Minuto do cron de atualizacao de feeds (vazio = desliga)
FRESHRSS_CRON_MIN=30

# ============================================================
# WhisperX
# ============================================================
# A imagem le estas variaveis SEM o prefixo WHISPERX_ (ver app/pipeline.py
# dentro do container). O Compose faz a traducao. Idioma e prompt sao
# parametros de cada requisicao (language=, initial_prompt=).
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
# Janelas de 30 s em paralelo na GPU. Acima de 4 o large-v3 estoura a VRAM.
WHISPERX_BATCH_SIZE=2
# Alinhamento de timestamps na CPU: -1,9 GB de pico de VRAM
# (com a GPU: 7,4 GB e 3x mais rapido no alinhamento)
WHISPERX_ALIGN_DEVICE=cpu
# Cache do Hugging Face no volume persistente (evita rebaixar ~3 GB)
WHISPERX_CACHE_DIR=/app/models
WHISPERX_MODEL=medium
# Este perfil usa medium (~2,6 GB de VRAM). Alternativas:
#   large-v3-turbo  ~2,5 GB de VRAM, qualidade maior que medium
#   large-v3         ~4,2 GB de VRAM, so com o chat dormindo
WHISPERX_MAX_LOADED_MODELS=1
WHISPERX_MAX_FILE_SIZE_MB=500
# Descarrega o modelo da GPU depois de 90 s ocioso
WHISPERX_MODEL_KEEP_ALIVE_SECONDS=90
WHISPERX_MODEL_EVICTION_INTERVAL_SECONDS=30
WHISPERX_LOGLEVEL=INFO
# Limite de memoria do container (decode de wav grandes pesa em RAM)
WHISPERX_MEM_LIMIT=5g
